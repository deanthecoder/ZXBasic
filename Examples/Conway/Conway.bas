100 REM INITIAL SETUP
105 DIM S(769)
106 LET S(80)=1: LET S(81)=1: LET S(82)=1
110 FOR N=1 TO 80
120 LET X=1+ INT ( RND *30): LET Y=1+ INT ( RND *22)
130 LET S(Y*32+X+1)=1
140 NEXT N
150 GO SUB 1000
200 REM ADVANCE
210 FOR Y=1 TO 22
220 FOR X=1 TO 30
226 LET O=Y*32+X+1
290 LET C= FN I(O,0,0)
300 LET A= FN C(O)
309 IF C=0 THEN GO TO 340
310 IF A<2 THEN LET C=0: GO TO 400
320 IF A<4 THEN GO TO 400
330 IF A>3 THEN LET C=0: GO TO 400
340 IF C=0 AND A=0 THEN GO TO 410
350 IF C=0 AND A=3 THEN LET C=1: GO TO 400
400 POKE 22527+O,56-C*56
410 NEXT X
420 NEXT Y
500 REM DISPLAY ATTR TO S
510 FOR N=1 TO 768
520 LET S(N)=1- INT ( PEEK (22527+N)/56)
530 NEXT N
999 GO TO 200
1000 REM UPDATE DISPLAY
1010 FOR N=1 TO 768
1020 POKE 22527+N,56-S(N)*56
1030 NEXT N
1040 RETURN
2000 DEF FN I(O,A,B)=S(O+A+B*32)
2010 DEF FN C(O)= FN I(O,-1,0)+ FN I(O,1,0)+ FN I(O,-1,-1)+ FN I(O,0,-1)+ FN I(O,1,-1)+ FN I(O,-1,1)+ FN I(O,0,1)+ FN I(O,1,1)
